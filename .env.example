# ============================================================================
# App Discotecas — variables de entorno (EJEMPLOS, sin credenciales reales)
# Copia este archivo como `.env.local` en `apps/web/` y rellena los valores.
# NUNCA subas `.env.local` al repositorio.
# ============================================================================

# --- Supabase (obligatorio) -------------------------------------------------
# Consíguelo en: Supabase Dashboard → Project Settings → API
# NEXT_PUBLIC_* es visible en el navegador (solo claves públicas/anónimas).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=clave-anonima-publica-de-supabase

# Clave de servicio: SOLO en servidor, NUNCA NEXT_PUBLIC. Se usa únicamente por
# el script de importación de locales (`npm run venues:import`) y tareas admin.
# Déjala vacía si no usas el script de importación.
SUPABASE_SERVICE_ROLE_KEY=

# --- OAuth / SMS (Supabase Auth) --------------------------------------------
# La autenticación con Google/Apple/SMS se configura íntegramente en el panel
# de Supabase (Authentication → Providers). Estas variables solo indican a la
# web qué proveedores están habilitados para mostrar la UI correspondiente.
# Formato: lista separada por comas. Ej: "google,apple,phone"
NEXT_PUBLIC_AUTH_PROVIDERS=google,apple,phone

# --- Proveedor de mapas (opcional) ------------------------------------------
# Sin clave, la app muestra listado + enlaces externos (funcional, sin mapa).
# Proveedor recomendado: Mapbox. Alternativa sin coste: Leaflet + OpenStreetMap
# (requiere aceptar la atribución ODbL de OSM).
NEXT_PUBLIC_MAP_PROVIDER=
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Distancia / proximidad -------------------------------------------------
# Tolerancia (metros) para el check-in por proximidad. Es una comprobación
# orientativa y voluntaria, nunca una prueba de presencia física.
NEXT_PUBLIC_CHECKIN_RADIUS_M=500
